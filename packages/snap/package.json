{
  "name": "@astar-network/snap",
  "version": "0.9.0",
  "description": "Metamask snap to interact with Astar dapps.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AstarNetwork/metamask-snap-astar.git"
  },
  "license": "(MIT-0 OR Apache-2.0)",
  "main": "./dist/bundle.js",
  "files": [
    "dist/",
    "images/",
    "snap.manifest.json"
  ],
  "scripts": {
    "allow-scripts": "yarn workspace root allow-scripts",
    "build": "mm-snap build",
    "build:clean": "yarn clean && yarn build",
    "clean": "rimraf dist",
    "lint": "yarn lint:eslint && yarn lint:misc --check",
    "lint:eslint": "eslint . --cache --ext js,ts",
    "lint:fix": "yarn lint:eslint --fix && yarn lint:misc --write",
    "lint:misc": "prettier '**/*.json' '**/*.md' '**/*.yml' '!.yarnrc.yml' --ignore-path ../../.gitignore --no-error-on-unmatched-pattern",
    "prepublishOnly": "mm-snap manifest",
    "serve": "mm-snap serve",
    "start": "mm-snap watch",
    "test": "jest"
  },
  "dependencies": {
    "@metamask/snaps-sdk": "~6.24.0",
    "@polkadot/api": "latest",
    "@polkadot/keyring": "^13.0.2",
    "@polkadot/types": "latest",
    "@polkadot/util": "^13.0.2",
    "deepmerge": "^4.3.1",
    "superstruct": "^2.0.2"
  },
  "devDependencies": {
    "@astar-network/metamask-astar-types": "workspace:^",
    "@jest/globals": "^29.5.0",
    "@metamask/snaps-cli": "^8.0.0",
    "@metamask/snaps-jest": "^9.1.0",
    "@types/chai": "^4.3.9",
    "@types/mocha": "^10.0.3",
    "@types/react": "18.2.4",
    "@types/react-dom": "18.2.4",
    "@types/sinon": "^10.0.20",
    "@types/sinon-chai": "^3.2.11",
    "@typescript-eslint/eslint-plugin": "^5.27.1",
    "@typescript-eslint/parser": "^5.27.1",
    "chai": "^4.3.10",
    "concurrently": "^5.1.0",
    "eslint": "^9.11.0",
    "jest": "^29.5.0",
    "mocha": "^10.2.0",
    "rimraf": "^3.0.2",
    "sinon": "^17.0.1",
    "sinon-chai": "^3.7.0",
    "strict-event-emitter-types": "^2.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^8.6.2",
    "typescript": "~5.7.3"
  },
  "packageManager": "yarn@3.2.1",
  "engines": {
    "node": ">=18.6.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
